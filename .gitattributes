# Normalize line endings: LF in the repository and in the working copy.
# Visual Studio, VS Code and the Angular tooling all handle LF on Windows.
* text=auto eol=lf

# Windows scripts need CRLF to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
